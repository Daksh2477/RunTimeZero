# Copy to .env and fill in. Never commit .env.

# Local Postgres over the unix socket (peer auth) — no password needed.
# If you get "client password must be a string", it means node-pg tried TCP:
# the ?host= parameter is what forces the socket.
DATABASE_URL=postgresql:///algacarbon?host=/var/run/postgresql

# Password auth over TCP instead, if you prefer:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/algacarbon

API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Copernicus Data Space — register free at dataspace.copernicus.eu
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Open-Meteo needs no key. Left here so nobody goes looking for one.
WEATHER_BASE_URL=https://api.open-meteo.com/v1

# Polygon Amoy testnet. Faucet: faucet.polygon.technology
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Oracle signing key. TESTNET ONLY — never a key holding real funds.
ORACLE_PRIVATE_KEY=

# IPFS pinning (web3.storage or Pinata free tier)
IPFS_TOKEN=
