# Copy to .env and fill in. Never commit .env.

# Local Postgres over the unix socket (peer auth) — no password needed.
# If you get "client password must be a string", it means node-pg tried TCP:
# the ?host= parameter is what forces the socket.
DATABASE_URL=postgresql:///algacarbon?host=/var/run/postgresql

# Password auth over TCP instead, if you prefer:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/algacarbon

API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Copernicus Data Space — register free at dataspace.copernicus.eu
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Open-Meteo needs no key. Left here so nobody goes looking for one.
WEATHER_BASE_URL=https://api.open-meteo.com/v1

# Polygon Amoy testnet. Faucet: faucet.polygon.technology
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Ethereum Sepolia, the other configured network.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Oracle signing key. TESTNET ONLY — never a key holding real funds.
# Used by hardhat to DEPLOY (apps/contracts/hardhat.config.cjs).
ORACLE_PRIVATE_KEY=

# What the API reads to ANCHOR. Different names from the deploy variables above
# on purpose — deploying and signing are separate jobs — but that also means
# filling in ORACLE_PRIVATE_KEY alone leaves the API unconfigured and every
# batch un-anchored. Fill these from apps/contracts/addresses.json after
# `npm run deploy:sepolia --workspace=apps/contracts`. See docs/DEPLOY-CHAIN.md.
CHAIN_RPC_URL=
CHAIN_KEY=
CHAIN_BATCH_EVIDENCE=
CHAIN_CARBON_CREDIT=
CHAIN_RETIREMENT_CERT=

# IPFS pinning (web3.storage or Pinata free tier). Nothing reads this yet —
# batch-service.ts uses the report hash in place of a CID until a pin exists.
IPFS_TOKEN=

# Token signing secret. Without it the API generates a random one per boot,
# so every restart signs everybody out. Any 32+ random characters.
AUTH_SECRET=
# Turn the operator READ screens private too. Leave off until the console
# has a login screen — writes are gated regardless.
AUTH_ENFORCE_READS=false
