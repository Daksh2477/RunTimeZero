{
  "name": "algacarbon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/api & npm run dev --workspace=apps/web",
    "db:setup": "psql \"$DATABASE_URL\" -f apps/api/src/db/schema.sql",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "typecheck": "tsc --build",
    "physics:build": "cd packages/physics && wasm-pack build --target nodejs --out-dir pkg",
    "sim": "node --experimental-strip-types scripts/sim-driver.ts",
    "api": "npm run dev --workspace=apps/api",
    "replay": "node --experimental-strip-types scripts/replay.ts",
    "ingest:sentinel": "node --experimental-strip-types scripts/ingest-sentinel.ts"
  }
}
